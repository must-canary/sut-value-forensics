# Server-side configuration for the daily market sync.
#
# Copy to .env.local and fill in. .env.local is gitignored and is read ONLY by
# the Node cron entrypoint (scripts/daily-sync.ts). None of these variables is
# prefixed VITE_, so Vite never inlines them into the client bundle and no value
# can reach the browser, localStorage or a stored report.

# CoinMarketCap Pro API key. Sent as the X-CMC_PRO_API_KEY request header.
CMC_API_KEY=

# Optional overrides.
SUT_DAILY_STORE=work/daily-market-store.json
SUT_DAILY_REQUEST_GAP_MS=1500
# SUT_DAILY_RPC_URL=https://polygon-bor-rpc.publicnode.com
